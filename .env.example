# Copia este archivo a .env y rellénalo. .env nunca se sube a git.
#
# Estos valores solo se usan en el PRIMER arranque (cuando aún no existe data/users.json).
# Después se cambian desde la app: botón de Ajustes (engranaje) al lado de "Salir".

# Puerto donde escucha el dashboard (el mismo dentro y fuera del contenedor).
PORT=8095

# Carpeta del servidor donde se guardan los datos (usuario, ajustes, claves, dispositivos y storage/).
# Ruta absoluta o relativa a esta carpeta. Haz copia de seguridad de ella.
DATA_PATH=./data

# IP o nombre de la impresora en tu red (sin http:// ni puerto). Ej: 192.168.1.50
PRINTER_HOST=

# Dirección pública del dashboard (se usa en los avisos para abrir la app). Ej: https://impresora.midominio.com
# Si no pones https:// se añade solo.
PANEL_URL=

# IP del proxy inverso que tengas delante (Nginx Proxy Manager, Traefik...), separadas por comas.
# Así el dashboard ve la IP real de cada visitante. Ej: 192.168.1.10
TRUSTED_PROXIES=

# Correo de contacto para las notificaciones push. Apple (iPhone), Google y Mozilla lo exigen
# para aceptar los avisos: sin él no llegan. Solo lo ven ellos si hay un problema con el envío.
PUSH_CONTACT_EMAIL=

# Zona horaria de los registros. Ej: America/New_York
TZ=
